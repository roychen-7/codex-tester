# Local Docker Compose configuration. Copy to .env; do not commit real secrets.
APP_ENV=local
WEB_PORT=5173
API_PORT=13000
LOG_LEVEL=debug
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=agent
MYSQL_USER=agent
# make init-env fills empty passwords with locally generated random values.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_TLS=false
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
