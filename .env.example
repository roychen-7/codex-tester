# Local Docker Compose configuration. Copy to .env; do not commit real secrets.
APP_ENV=local
WEB_PORT=5173
API_PORT=13000
LOG_LEVEL=debug
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=agent
MYSQL_USER=agent
# make init-env fills empty passwords with locally generated random values.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_TLS=false
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Both key and model are required to enable AI. Leave both empty for session-only mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=120

# 独立 MCP 服务使用；默认聊天 Compose 不传入这些变量。
# 本地模拟环境使用 compose.query-test.yaml 的专用测试配置。
# 分项配置，密码直接填写，无需 URL 编码；端口默认 5432，SSL 默认 verify-full。
QUERY_POSTGRES_HOST=
QUERY_POSTGRES_PORT=
QUERY_POSTGRES_DATABASE=
QUERY_POSTGRES_USER=
QUERY_POSTGRES_PASSWORD=
QUERY_POSTGRES_SSLMODE=
# 兼容旧配置：DSN 与上面的非空分项配置不能同时使用。
QUERY_POSTGRES_DSN=
QUERY_MCP_TOKEN=
QUERY_MCP_ADDRESS=127.0.0.1:13003

# Optional agent-to-MCP connection; server only. Both empty disables analysis.
AGENT_MCP_URL=
AGENT_MCP_TOKEN=

# conversation: continuous chat (default); legacy: previous confirm-and-analyze demo
AGENT_MODE=conversation

TAVILY_API_KEY=你的密钥
# Local test fixtures only; production uses the official endpoint
# TAVILY_BASE_URL=https://api.tavily.com

# synthetic 或 live；线上覆盖文件会固定设置 live。
QUERY_DATA_SOURCE=synthetic
AGENT_DATA_SOURCE=synthetic
